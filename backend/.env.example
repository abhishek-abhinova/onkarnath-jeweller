# ============================================================
# ओंकार नाथ अग्रवाल सर्राफ — Backend environment
# Copy to backend/.env and fill in real values for production.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# Comma separated list of allowed frontend origins (for CORS + cookies)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006

# --- Database (optional for demo) ---
# If MONGO_URI is empty, the API automatically falls back to a
# local JSON-file store (backend/data/db.json) so the demo runs
# without MongoDB. In production, use MongoDB Atlas.
MONGO_URI=

# --- Admin auth ---
# In production use a long random value. For the demo the seed creates:
#   username/email: admin    email: admin@onassarraf.com   password: admin123
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES=8h

# --- Rate source ---
# ibja     -> fetch from the client's authorized IBJA API (needs keys below)
# fallback -> serve admin/manual fallback rates. NO live claims are shown.
# off      -> serve only the last cached rate.
#
# IMPORTANT (DEMO):
#   The IBJA API key must NEVER appear in React, Android or public JS code.
#   It lives only here, on the backend. Insert the client's authorized
#   credentials below. Do NOT scrape the IBJA website.
RATES_MODE=fallback

# Authorized IBJA API credentials — INSERT the client's values here.
IBJA_API_URL=
IBJA_API_KEY=

# How often the backend schedules a fetch in minutes (default 60)
RATES_SYNC_MINUTES=60

# Request timeout for the IBJA call in ms
IBJA_TIMEOUT_MS=15000

# --- Uploads ---
MAX_UPLOAD_MB=5